# Everything in this repo is authored with LF. The dashboard build compares the
# generated literal against web/ byte for byte, so a CRLF checkout would make
# every npm test rewrite extensions/dashboard.generated.ts.
* text=auto eol=lf

# Generated by scripts/build-web.mjs. Fold it in review; edit web/ instead.
extensions/dashboard.generated.ts linguist-generated=true
