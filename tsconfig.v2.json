{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "scripts/**/*.mjs",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
