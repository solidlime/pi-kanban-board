{
  "name": "pi-kanban-board",
  "version": "0.3.0",
  "description": "Kanban board for pi: a session-scoped board the agent keeps in sync, an HTTP dashboard on port 8789, and an autonomous doing-loop.",
  "keywords": [
    "pi-package",
    "pi",
    "kanban",
    "task-board",
    "agent"
  ],
  "license": "MIT",
  "author": "solidlime",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidlime/pi-kanban-board.git"
  },
  "homepage": "https://github.com/solidlime/pi-kanban-board#readme",
  "bugs": {
    "url": "https://github.com/solidlime/pi-kanban-board/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/kanban.ts"
    ]
  },
  "files": [
    "extensions/kanban.ts",
    "extensions/dashboard.generated.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "pretest": "node scripts/build-web.mjs --check",
    "prepack": "node scripts/build-web.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "typebox": "^1.4.2"
  }
}
